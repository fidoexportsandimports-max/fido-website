# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.fidoexim.com

# --- Enquiry email (optional). Without it, enquiries are saved to the CRM and logged only. ---
RESEND_API_KEY=
ENQUIRY_FROM="FIDO Exim <enquiries@fidoexim.com>"

# --- CRM (no login: private link at /crm/<CRM_KEY>) ---
# Required in production. Use a long random value, e.g. `openssl rand -hex 24`.
CRM_KEY=

# --- CRM storage in production (Vercel Storage > Upstash Redis / KV sets these for you) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are also accepted)
